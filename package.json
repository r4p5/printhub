{
  "name": "printhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "npm run dev -w @printhub/server",
    "dev:web": "npm run dev -w @printhub/web",
    "build:web": "npm run build -w @printhub/web",
    "dist:win": "npm run dist -w @printhub/desktop",
    "test": "node --test packages/shared/test/*.test.ts packages/server/test/*.test.ts packages/web/test/*.test.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/web --noEmit",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "deploy:directory": "cd packages/directory && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0"
  }
}
